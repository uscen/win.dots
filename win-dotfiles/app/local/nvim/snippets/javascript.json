  },
  "import": {
    "prefix": "imp",
    "body": "import '${1:module}';$0",
    "description": "Imports entire module in ES6 syntax without module name"
  },
  "importModule": {
    "prefix": "imf",
    "body": "import ${1:moduleName} from '${2:module}';$0",
    "description": "Imports entire module statement in ES6 syntax"
  },
  "importEverything": {
    "prefix": "ime",
