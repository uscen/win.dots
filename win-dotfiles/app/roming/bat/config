# =============================================================================== #
# General:                                                                        #
# =============================================================================== #
--theme=thorn
--style=numbers,changes
--italic-text=always
--wrap=never
--paging=auto
--pager=less
--color=always
--decorations=always

# =============================================================================== #
# Syntax:                                                                         #
# =============================================================================== #
--map-syntax '.*ignore:Git Ignore'
--map-syntax '.gitconfig.local:Git Config'
--map-syntax '**/completions/_*:Bourne Again Shell (bash)'
--map-syntax '.zsh*:Bourne Again Shell (bash)'
--map-syntax '**/vim/vimrc:VimL'
