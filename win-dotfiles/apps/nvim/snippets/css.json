{
  "!": {
    "prefix": "!",
    "body": [
      "* {",
      "\tpadding: 0;",
      "\tmargin: 0;",
      "\tbox-sizing: border-box;",
      "\tfont-family: Roboto, system-ui, 'Segoe UI', Helvetica, Arial,",
      "\tsans-serif, 'Apple Color Emoji', 'Segoe UI', 'Emoji', 'Segoe UI Symbol';",
      "}",
      "",
      "html {",
      "\tscroll-behavior: smooth;",
      "}",
      "",
      "body {",
      "\theight: auto;",
      "\tmax-width: 1200px;",
      "}",
      "",
      "ul {",
      "\tlist-style-type: none;",
      "}",
      "",
      "a {",
      "\ttext-decoration: none;",
      "}",
      "",
      "img, video {",
      "\tmax-width: 100%",
      "}",
      "",
      "p {",
      "\tfont-size: 1em;",
      "\tletter-spacing: 0.05em;",
      "\tline-height: calc(1ex / 0.32);",
      "}",
      "",
      "@media (max-width: 767pxpx) {",
      "}",
      "",
      "@media (min-width: 768px) {",
      "}",
      "",
      "@media (min-width: 992px) {",
      "}",
      "",
      "@media (min-width: 1200px) {",
      "}",
      "",
      "@media (min-width: 1800px) {",
      "}"
    ]
  },
  "Container": {
    "prefix": "container",
    "body": [
      ".container {",
      "\tpadding-left: 15px;",
      "\tpadding-right: 15px;",
      "\tmargin-left: auto;",
      "\tmargin-right: auto;",
      "}",
      "",
      "@media (min-width: 768px) {",
      "\t.container {",
      "\t\twidth: 750px;",
      "\t}",
      "}",
      "",
      "@media (min-width: 992px) {",
      "\t.container {",
      "\t\twidth: 970px;",
      "\t}",
      "}",
      "",
      "@media (min-width: 1200px) {",
      "\t.container {",
      "\t\twidth: 1170px;",
      "\t}",
      "}"
    ]
  },
  "Border": {
    "prefix": "test",
    "body": ["border: 1px solid black;"]
  },
  "Pop Up Menu": {
    "prefix": "PopUp",
    "body": [
      ".pop-up-menu {position: absolute; opacity: 0; visibility: hidden; top: 170px; left: 720px; border-radius: 35px; box-shadow: 0px 0px 10px 0px rgba(0, 0, 0, 0.439); background: rgba(255, 255, 255, 0.8); padding: 15px; text-align: left; transition: 0.3s opacity, 0.3s visibility; z-index: 1; }",
      ".pop-up-menu h3 { font-size: 1em; padding-bottom: 15px; border-bottom: 1px solid rgba(128, 128, 128, 0.6); margin-top: 10px; }",
      ".pop-up-menu ul {text-align: left; padding-left: 20px; letter-spacing: 0.05em; font-size: 1em; list-style: none; }"
    ]
  },
  "Hidden Box": {
    "prefix": "hide",
    "body": [
      ".hidden-box {",
      "\twidth: 0px;",
      "\theight: 0px;",
      "\toverflow: visible;",
      "\tz-index: 1;",
      "\ttransition: opacity 0.3s;",
      "}"
    ]
  },
  "Not Visible": {
    "prefix": "not-visible",
    "body": [
      ".not-visible {",
      "\ttransform: scale(0);",
      "\theight: 0px;",
      "\twidth: 0px;",
      "\tmargin: 0;",
      "\tpadding: 0;",
      "\topacity: 0;",
      "}",
      "",
      ".not-visible * {",
      "\tmargin: 0;",
      "\tpadding: 0;",
      "}"
    ]
  }
}
